# AIFA GEN LABS Admin Portal - Environment Variables Template
# Copy this file to .env and configure your credentials.
#
# IMPORTANT: Never commit actual secret keys or .env files to Git.

# Optional: AI Provider Keys (Groq or Google Gemini)
# If omitted, the portal automatically engages the built-in Deterministic Semantic NLU Parser with 100% offline accuracy.
GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration (Optional)
PORT=5001

# Administrator Default Authentication Credentials (server-side only)
ADMIN_EMAIL=admin@aifagen@gmail.com
ADMIN_PASSWORD=admin@123
SESSION_SECRET=your_secure_random_jwt_session_secret_key_here
